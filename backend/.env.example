# Server
PORT=5500
NODE_ENV=development

# MySQL database. Use a dedicated account, not root. See DEPLOYMENT.md.
DB_HOST=127.0.0.1
DB_USER=mlu_app
DB_PASSWORD=choose_a_long_password
DB_NAME=mlu_kitchen_cafe_db

# Auth — generate a long random string for production (never commit the real value)
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters; the server refuses to boot in production otherwise.
JWT_SECRET=replace_with_a_long_random_secret_key

# How long an issued session token stays valid. The server caps this at 2 hours.
JWT_EXPIRES_IN=2h

# Administrator inbox for 24-hour login-lockout alerts. Password resets are done
# by an administrator in User Management and are not emailed.
ADMIN_EMAIL=admin@example.com

# Optional SMTP. Leave blank in local dev: messages are written to backend/logs/mail.log.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=admin@example.com
# SMTP_PASS=your_smtp_password
# SMTP_FROM=Mlu Kitchen & Cafe <admin@example.com>

# Optional password for scripts/seed-admin.js. If unset, the script writes a random
# password to backend/logs/initial-admin-password.txt and does not print it.
# SEED_ADMIN_PASSWORD=

# Frontend origin for CORS (your deployed React app URL)
FRONTEND_URL=http://localhost:5173

# ==========================================
# Security
# ==========================================
# Extra allowed browser origins, comma separated. Defaults to FRONTEND_URL alone.
# CORS_ALLOWED_ORIGINS=https://cafe.example.com,https://www.cafe.example.com

# Set to true ONLY when running behind a reverse proxy (nginx, Cloudflare, Heroku).
# If enabled without a proxy, clients can spoof X-Forwarded-For and evade rate limits.
# TRUST_PROXY=false

# Failed logins allowed per IP per 15 minutes before the endpoint locks out
# LOGIN_ATTEMPT_LIMIT=10
# Requests allowed per IP per 15 minutes across the signed-in API
# API_RATE_LIMIT=300
# Backup / restore / export calls allowed per IP per 15 minutes
# SENSITIVE_RATE_LIMIT=20
# Maximum accepted request body size
# JSON_BODY_LIMIT=1mb

# Optional: path to MySQL bin folder (mysqldump/mysql) if not on PATH or Laragon default
# MYSQL_BIN=C:\laragon\bin\mysql\mysql-8.4.3-winx64\bin
# LARAGON_ROOT=C:\laragon

# How long the in-memory stock-alert snapshot is reused
# ALERTS_CACHE_TTL_MS=20000

# Optional dashboard weather pin (defaults to Siem Reap). No API key is required.
# WEATHER_LAT=13.3644
# WEATHER_LON=103.8603
# WEATHER_LOCATION=Siem Reap
