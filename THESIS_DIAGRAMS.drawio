          <mxGeometry x="60" y="780" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="1.0&lt;br&gt;Log in and&lt;br&gt;check permission" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="120" width="150" height="150" as="geometry" />
