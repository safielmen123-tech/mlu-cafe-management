          <mxGeometry relative="1" as="geometry">
            <mxPoint x="180" y="236" as="sourcePoint" />
            <mxPoint x="470" y="236" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e9" value="" style="html=1;fontSize=11;endArrow=block;rounded=0;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="470" y="282" as="sourcePoint" />
            <mxPoint x="540" y="282" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e10" value="" style="html=1;fontSize=11;endArrow=block;rounded=0;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="540" y="282" as="sourcePoint" />
            <mxPoint x="540" y="298" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e11" value="3. Calculate subtotal, tax is always zero" style="html=1;fontSize=11;endArrow=block;rounded=0;strokeColor=#333333;" edge="1" parent="1">
