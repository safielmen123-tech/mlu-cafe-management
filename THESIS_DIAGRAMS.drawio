          <mxGeometry relative="1" as="geometry">
            <mxPoint x="830" y="390" as="sourcePoint" />
            <mxPoint x="764" y="390" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e16" value="6. Create or reuse the pending order" style="html=1;fontSize=11;endArrow=block;rounded=0;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="420" as="sourcePoint" />
            <mxPoint x="1050" y="420" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e17" value="7. Insert the order line items" style="html=1;fontSize=11;endArrow=block;rounded=0;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="466" as="sourcePoint" />
            <mxPoint x="1050" y="466" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e18" value="8. Confirm the order was saved" style="html=1;fontSize=11;endArrow=open;dashed=1;rounded=0;strokeColor=#666666;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="512" as="sourcePoint" />
            <mxPoint x="470" y="512" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e19" value="9. Open Payment, choose Cash or Bank Scan" style="html=1;fontSize=11;endArrow=block;rounded=0;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="180" y="558" as="sourcePoint" />
            <mxPoint x="470" y="558" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e20" value="10. POST /api/orders/checkout" style="html=1;fontSize=11;endArrow=block;rounded=0;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="470" y="604" as="sourcePoint" />
            <mxPoint x="760" y="604" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e21" value="11. Mark Completed and save the invoice" style="html=1;fontSize=11;endArrow=block;rounded=0;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="650" as="sourcePoint" />
            <mxPoint x="1050" y="650" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e22" value="12. Write payment record to audit_logs" style="html=1;fontSize=11;endArrow=block;rounded=0;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="696" as="sourcePoint" />
            <mxPoint x="1050" y="696" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e23" value="13. Confirm payment" style="html=1;fontSize=11;endArrow=open;dashed=1;rounded=0;strokeColor=#666666;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="742" as="sourcePoint" />
            <mxPoint x="470" y="742" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e24" value="14. Show and print the receipt" style="html=1;fontSize=11;endArrow=open;dashed=1;rounded=0;strokeColor=#666666;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="470" y="788" as="sourcePoint" />
            <mxPoint x="180" y="788" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n25" value="&lt;b&gt;Points to explain&lt;/b&gt;&lt;br&gt;&lt;br&gt;Step 6 &amp;nbsp;&amp;nbsp;The order is saved as &quot;Pending&quot; the moment the first item is added, so nothing is lost if the browser closes.&lt;br&gt;Step 3 &amp;nbsp;&amp;nbsp;Tax is set to zero in both the frontend and the backend, so the total always equals the subtotal.&lt;br&gt;Step 11 &amp;nbsp;The update only succeeds if the ticket is still pending. This is what stops the same bill being paid twice.&lt;br&gt;Step 12 &amp;nbsp;Every payment records who took it, how much, and by which method.&lt;br&gt;Step 14 &amp;nbsp;The receipt is printed by the browser using a stylesheet sized for an 80mm thermal printer." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffcc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="884" width="900" height="170" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-6" name="6. Data Flow Diagram (Level 1)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
