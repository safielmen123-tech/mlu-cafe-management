        </mxCell>
        <mxCell id="e14" value="revenue forecast" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;dashed=1;endArrow=block;" edge="1" parent="1" source="n7" target="n5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e15" value="only when needed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;endArrow=block;" edge="1" parent="1" source="n5" target="n8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n16" value="&lt;b&gt;Reading the diagram&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Staff work only in the browser.&lt;br&gt;2. The frontend never touches the database.&lt;br&gt;3. The API checks the token and permission first.&lt;br&gt;4. Only the API talks to MySQL, always with&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;placeholder queries (no SQL injection).&lt;br&gt;5. Python is called only for the forecast screen.&lt;br&gt;6. External services are optional; the system&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;still works without them." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffcc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1130" y="120" width="330" height="240" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
