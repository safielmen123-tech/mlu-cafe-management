          <mxGeometry x="40" y="20" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="Circles are processes. Open boxes are data stores. Red boxes are people or systems outside." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="950" height="20" as="geometry" />
        </mxCell>
