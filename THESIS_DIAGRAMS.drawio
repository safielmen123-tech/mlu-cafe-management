          <mxGeometry x="60" y="430" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="Customer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="200" width="150" height="60" as="geometry" />
        </mxCell>
