          <mxGeometry x="530" y="120" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="External Services&lt;br&gt;Email, Weather, Exchange Rate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
