          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="result rows" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;dashed=1;endArrow=block;" edge="1" parent="1" source="n6" target="n5">
