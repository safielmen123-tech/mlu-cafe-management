          <mxGeometry relative="1" as="geometry">
            <mxPoint x="830" y="436" as="sourcePoint" />
            <mxPoint x="764" y="436" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e17" edge="1" parent="1" style="html=1;fontSize=11;endArrow=block;rounded=0;strokeColor=#333333;" value="7. Write login record to audit_logs">
          <mxGeometry relative="1" as="geometry">
